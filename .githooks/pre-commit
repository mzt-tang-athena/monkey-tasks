#!/bin/sh
# Fast checks on the staged files only. The slow gates (typecheck, tests,
# bundle) stay in CI, so a commit stays under a few seconds.
#
# Install once per clone: make hooks
set -e

root=$(git rev-parse --show-toplevel)
# One name per line, unquoted. Some names hold spaces, so each list goes
# to xargs NUL separated.
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM)

code=$(printf '%s\n' "$staged" | grep -E '^app/(src|scripts|e2e)/.*\.(ts|tsx)$' || true)
docs=$(printf '%s\n' "$staged" | grep -E '\.md$' || true)

if [ -n "$code" ]; then
  echo "eslint: $(printf '%s\n' "$code" | wc -l) file(s)"
  # A warning fails the commit too: CI runs with the same limit.
  (cd "$root/app" && printf '%s\n' "$code" | sed 's|^app/||' | tr '\n' '\0' | xargs -0 npx --no-install eslint --max-warnings 0)
fi

if [ -n "$docs" ]; then
  if command -v vale >/dev/null 2>&1; then
    echo "vale: $(printf '%s\n' "$docs" | wc -l) file(s)"
    # Vale exits zero on warnings, so the commit fails on any output. A
    # nonzero exit with no output means Vale itself failed, for example
    # on a path it cannot read, so that fails the commit too.
    vale_exit=0
    alerts=$(cd "$root" && printf '%s\n' "$docs" | tr '\n' '\0' | xargs -0 vale --minAlertLevel=warning --output=line) || vale_exit=$?
    if [ -n "$alerts" ]; then
      printf '%s\n' "$alerts"
      echo "vale: fix the alerts above" >&2
      exit 1
    fi
    if [ "$vale_exit" -ne 0 ]; then
      echo "vale: exited with $vale_exit and printed no alerts. Its error is above." >&2
      exit 1
    fi
  else
    echo "vale is not installed, skipping the prose check" >&2
  fi
fi
